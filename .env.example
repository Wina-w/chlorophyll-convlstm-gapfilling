# Copy to .env (gitignored). Every entry is optional; defaults are repo-relative.

# Where the NetCDF inputs live / where checkpoints and outputs go
# (default: data/, models/, outputs/; smoke configs default to outputs_smoke/ so outputs/ keeps the published results)
CHL_DATA_DIR=
CHL_MODEL_DIR=
CHL_OUTPUT_DIR=

# MLflow (local sqlite by default; pip install 'chl-gapfill[track]'). A relative sqlite path is
# taken from the project root; new experiments keep their artifacts in <db folder>/artifacts/.
MLFLOW_TRACKING_URI=sqlite:///mlruns/mlflow.db

# --- optional external inputs for scripts/experiments/ (the DINEOF benchmarks) ---
# compiled DINEOF (Fortran) executable
DINEOF_EXE=
# my Sentinel-3 SST products: gappy baseline and its DINEOF L4
S3_SST_BASELINE_DIR=
S3_SST_DINEOF_L4_DIR=
# my Sentinel-3 OLCI chlorophyll .mat files
S3_CHL_MAT_DIR=
